# Local Qdrant from Docker (default: rag-okf stack on host port 6343)
# Start with: make qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6343
# Optional single URL override (takes precedence over HOST/PORT)
# QDRANT_URL=http://localhost:6343

QDRANT_COLLECTION=element_aware_chunks
# Optional, but recommended when FastEmbed needs to download the model from Hugging Face.
# Create a read token at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
PARSER_BACKEND=docling
PROCESSED_DIR=data/processed

# Path to docker-compose that defines the Qdrant service (used by `make qdrant`)
QDRANT_COMPOSE_FILE=../rag-okf/docker-compose.yml
